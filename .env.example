# Copie para .env (o .env nunca vai para o git). Todos os valores abaixo são fictícios.

# --- API ---
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# --- Regras de negócio (R6 e R2) --- 
CANCELAMENTO_ANTECEDENCIA_HORAS=48
DURACAO_AULA_MINUTOS=50

# --- PostgreSQL (usado pelo Docker Compose) ---
POSTGRES_USER=agenda
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=agenda

# --- Banco ao rodar a API ---
# Deixe vazio para guardar os dados em memória.                                  
# O host é "localhost"; dentro do Compose o host é "db" e o Compose monta a URL sozinho.
DATABASE_URL=postgresql://agenda:troque_esta_senha@localhost:5432/agenda    

# --- Teste de contrato dores real ---
# Sem esta variável o teste é pulado. Use um banco descartável, nunca o de dados reais.
TEST_DATABASE_URL=postgres@localhost:5432/agenda_test