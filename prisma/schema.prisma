// Datas em timestamptz: o Postgres guarda o instante em UTC e a grade de horários
// é interpretada em America/Fortaleza só na camada de domínio.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StatusAula {
  reservada
  cancelada
}

model Aluno {
  id      String   @id
  nome    String
  pacote  Pacote?
  aulas   Aula[]
  usuario Usuario?
}

enum Papel {
  admin
  instrutor
  aluno
}

/// Conta de acesso. O e-mail é dado pessoal (ver docs/lgpd.md); a senha nunca é guardada,
/// só o hash (scrypt).
model Usuario {
  id        String   @id
  email     String   @unique
  senhaHash String
  papel     Papel
  alunoId   String?  @unique
  aluno     Aluno?   @relation(fields: [alunoId], references: [id])
  sessoes   Sessao[]
}

/// Sessão de login. A chave é o SHA-256 do token: o token em si nunca é gravado.
/// `papel` e `alunoId` são cópias da conta, para identificar a requisição com uma consulta.
model Sessao {
  tokenHash String   @id
  usuarioId String
  papel     Papel
  alunoId   String?
  expiraEm  DateTime @db.Timestamptz(3)
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([expiraEm])
}

// R5: `CHECK (saldo >= 0)` está na migration `saldo_nao_negativo` (o Prisma não o expressa aqui).
model Pacote {
  alunoId String @id
  saldo   Int
  aluno   Aluno  @relation(fields: [alunoId], references: [id])
}

/// Horário (início da aula) publicado pelo instrutor.
model Disponibilidade {
  inicio DateTime @id @db.Timestamptz(3)
}

// R3 (um aluno por horário) é garantida também pelo banco: o índice único parcial
// `Aula_inicio_reservada_key` está na migration, pois o Prisma não o expressa aqui.
model Aula {
  id      String     @id
  alunoId String
  inicio  DateTime   @db.Timestamptz(3)
  fim     DateTime   @db.Timestamptz(3)
  status  StatusAula
  aluno   Aluno      @relation(fields: [alunoId], references: [id])

  @@index([inicio])
}
