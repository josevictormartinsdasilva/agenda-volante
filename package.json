{
  "name": "agenda-volante",
  "version": "0.1.0",
  "private": true,
  "description": "API de agendamento de aulas para instrutor de trânsito autônomo",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "lint:api": "spectral lint docs/openapi.yaml --fail-severity=warn",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "fastify": "^5.12.8",
    "prisma": "^6.19.3",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@stoplight/spectral-cli": "^6.17.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.7",
    "yaml": "^2.9.1"
  }
}
