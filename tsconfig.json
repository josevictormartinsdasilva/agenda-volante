{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "types": ["node"],
    // A interface (web/) é JavaScript sem build; o tsc confere os tipos pelos comentários JSDoc.
    "allowJs": true,
    "checkJs": true
  },
  "include": ["src", "tests", "web", "vitest.config.ts"]
}
